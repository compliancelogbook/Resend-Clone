# Private settings. Copy to .env and fill in. .env is never committed to GitHub.

# Resend (https://resend.com) - used by the contact form and newsletter
RESEND_API_KEY=
# Sender address. Must be on a domain you've verified in Resend, e.g. EasyFeezy <hello@easyfeezy.com>
CONTACT_FROM=EasyFeezy <onboarding@resend.dev>

# Contact form: the inbox that receives enquiries
CONTACT_TO=

# Newsletter: one Resend Topic per list (Resend > Audience > Topics). Create each with
# default subscription "Opt-out", then copy its ID here.
RESEND_TOPIC_WEEKLY=
RESEND_TOPIC_DAILY=
RESEND_TOPIC_UPDATES=
# Any long random string, used to sign confirmation links
SUBSCRIBE_SECRET=
# Where the site runs, used in confirmation links
SITE_URL=http://localhost:5173
